{
  "name": "@perryts/iroh",
  "version": "0.1.2",
  "description": "Iroh P2P framework bindings (direct peer-to-peer QUIC + hole punching + relay fallback) for the Perry TypeScript-to-native compiler.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryTS/iroh-bindings.git"
  },
  "homepage": "https://github.com/PerryTS/iroh-bindings#readme",
  "bugs": {
    "url": "https://github.com/PerryTS/perry/issues"
  },
  "keywords": [
    "perry",
    "perryts",
    "iroh",
    "p2p",
    "quic",
    "networking"
  ],
  "types": "src/index.d.ts",
  "files": [
    "src/",
    "Cargo.toml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "perry": {
    "nativeLibrary": {
      "abiVersion": "0.5",
      "functions": [
        {
          "name": "js_iroh_bind",
          "params": [],
          "returns": "promise"
        },
        {
          "name": "js_iroh_node_id",
          "params": [
            "i64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_close",
          "params": [
            "i64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_connect",
          "params": [
            "i64",
            "string"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_accept_one",
          "params": [
            "i64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_open_bi",
          "params": [
            "i64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_accept_bi",
          "params": [
            "i64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_stream_write",
          "params": [
            "i64",
            "string"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_stream_finish",
          "params": [
            "i64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_stream_read_to_end",
          "params": [
            "i64",
            "f64"
          ],
          "returns": "promise"
        },
        {
          "name": "js_iroh_conn_close",
          "params": [
            "i64"
          ],
          "returns": "promise"
        }
      ],
      "targets": {
        "macos": {
          "cargo_features": [],
          "frameworks": []
        },
        "linux": {
          "cargo_features": []
        },
        "windows": {
          "cargo_features": []
        }
      }
    }
  }
}
